      "pluginVersion": "11.0.0",
      "targets": [
        {
          "format": "table",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "SELECT task_id, filename, status, created_at, updated_at,\n       CASE\n         WHEN completed_at IS NOT NULL THEN\n           ROUND(EXTRACT(EPOCH FROM (completed_at - created_at))::numeric, 1)\n         ELSE NULL\n       END as duration_seconds\nFROM pdf_validation_tasks\nORDER BY created_at DESC\nLIMIT 10",
          "refId": "A",
          "select": [
            [
              {
                "params": [
                  "value"
                ],
                "type": "column"
              }
            ]
          ],
          "timeColumn": "time",
          "where": [
            {
              "name": "$__timeFilter",
              "params": [],
              "type": "macro"
            }
          ]
        }
      ],
